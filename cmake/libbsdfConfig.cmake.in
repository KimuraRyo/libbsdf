@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Eigen3)

if(@LIBBSDF_ENABLE_FITTING@)
    find_dependency(Ceres)
endif()

if(@OpenMP_CXX_FOUND@)
    find_dependency(OpenMP)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/libbsdfTargets.cmake")

check_required_components(libbsdf)
